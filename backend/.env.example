# ProjectOps Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./projectops.db
# PostgreSQL Alternative: postgresql+asyncpg://projectops:projectops_secret@localhost:5432/projectops
API_V1_PREFIX=/api/v1

# Authentication Settings (Argon2id + HS256 JWT)
# REQUIRED outside tests: Must be a secret key of at least 32 characters
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ALGORITHM=HS256

# LLM Provider Configuration ("claude", "grok", or "mock")
LLM_PROVIDER=mock
# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# xAI Grok Configuration
XAI_API_KEY=your-xai-api-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=projectops_dev_secret
GITHUB_REQUIRE_SIGNATURE=true
